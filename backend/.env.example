# SQLite works out of the box for a local demo. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/evidence_db
DATABASE_URL=sqlite:///./evidence.db
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50
APP_SECRET=replace-this-with-a-long-random-secret
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
